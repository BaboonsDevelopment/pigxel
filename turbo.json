{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "NEXT_PUBLIC_SUPABASE_*",
    "SUPABASE_SECRET_KEY",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "APPLE_CLIENT_ID",
    "GEMINI_API_KEY",
    "AI_MODEL",
    "AI_IMAGE_MODEL",
    "PADDLE_ENVIRONMENT",
    "PADDLE_CLIENT_TOKEN",
    "PADDLE_WEBHOOK_SECRET",
    "APP_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["^test:coverage"],
      "outputs": ["coverage/**"]
    },
    "test:db": {
      "cache": false,
      "passThroughEnv": ["HOME", "DOCKER_HOST", "PIGXEL_TEST_*"]
    },
    "test:e2e": {
      "cache": false,
      "passThroughEnv": [
        "CI",
        "HOME",
        "DOCKER_HOST",
        "E2E_SERVER",
        "PLAYWRIGHT_*",
        "PIGXEL_TEST_*"
      ]
    }
  },
  "agentGuidance": false
}
