# Supabase Auth; the landing page works without these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000

# Server-only Supabase key, used to keep Google Drive refresh tokens.
SUPABASE_SECRET_KEY=

# Google sign-in and Google Drive. The same OAuth client is set in Supabase
# (Authentication → Sign In / Providers → Google). Server-only.
# Without GOOGLE_CLIENT_ID the Google button is hidden; Drive also needs the
# secret and SUPABASE_SECRET_KEY.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Server-only. Keep development in sandbox mode.
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox

# Apple sign-in (optional). The Services ID also set in Supabase
# (Authentication → Sign In / Providers → Apple). Without it the Apple
# buttons are hidden. Server-only.
APPLE_CLIENT_ID=

# AI (server-only). OpenAI by default. AI_PROVIDER=gemini moves talk and plans
# to Google Gemini; AI_IMAGE_PROVIDER=gemini moves only the pictures (e.g.
# text from OpenAI, pictures from Gemini). Gemini needs GEMINI_API_KEY.
# AI_MODEL (talk), AI_SMART_MODEL (plans and precise pixel edits) and
# AI_IMAGE_MODEL pick the models to try first (see src/lib/ai/constants.ts);
# AI_IMAGE_QUALITY (OpenAI) is low, medium (default) or high.
AI_PROVIDER=
AI_IMAGE_PROVIDER=
OPENAI_API_KEY=
AI_MODEL=
AI_SMART_MODEL=
AI_IMAGE_MODEL=
AI_IMAGE_QUALITY=
GEMINI_API_KEY=
