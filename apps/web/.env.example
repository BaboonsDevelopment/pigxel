# Supabase Auth; the landing page works without these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000

# Server-only Supabase key, used for Drive refresh tokens and billing webhooks.
# Not required for basic Google or Apple sign-in.
SUPABASE_SECRET_KEY=

# Google sign-in and Google Drive. The same OAuth client is set in Supabase
# (Authentication → Sign In / Providers → Google). Server-only.
# Without GOOGLE_CLIENT_ID the Google login button is disabled. Basic sign-in
# needs the ID here and the ID/secret in Supabase; Drive additionally needs
# GOOGLE_CLIENT_SECRET and SUPABASE_SECRET_KEY here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Paddle. PADDLE_ENVIRONMENT is required (sandbox or production) and has no
# default; keep development on sandbox. The client-side token (Developer
# tools → Authentication) must match it: test_… for sandbox, live_… for
# production.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
# Server-only. The secret key of the notification destination that points
# at /api/paddle/webhook (Developer tools → Notifications).
PADDLE_WEBHOOK_SECRET=

# Apple sign-in (optional). The Services ID also set in Supabase
# (Authentication → Sign In / Providers → Apple). Without it the Apple
# login button is disabled. The generated Apple client secret belongs in
# Supabase's Apple provider configuration, not in the browser. Server-only.
APPLE_CLIENT_ID=

# Only for local Supabase: its config.toml references this generated JWT.
# Supabase CLI needs APPLE_SECRET in its own process environment; it does not
# inherit Next.js apps/web/.env.local. Hosted Supabase stores the JWT in its
# dashboard instead. Rotate before expiry (at most six months).
# APPLE_SECRET=

# AI (server-only): Google Gemini. AI_MODEL and AI_IMAGE_MODEL pick the text
# and image models to try first (see src/lib/ai/constants.ts).
GEMINI_API_KEY=
AI_MODEL=
AI_IMAGE_MODEL=
