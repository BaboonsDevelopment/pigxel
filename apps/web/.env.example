# Supabase Auth; the landing page works without these values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000

# Server-only Supabase key, used for billing webhooks and admin tasks.
# Not required for Google or Apple sign-in.
SUPABASE_SECRET_KEY=

# Google sign-in. The same OAuth client is set in Supabase (Authentication →
# Sign In / Providers → Google). Server-only. Without GOOGLE_CLIENT_ID the
# Google login button is disabled. GOOGLE_CLIENT_SECRET is read only by the
# local Supabase CLI (supabase/config.toml), not by the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Creem (server-only). A test key (creem_test_…) uses Creem's test API and a
# live key the real one. The pricing page selects matching product IDs.
# Use a test key locally and a live key on the production host.
# The key also screens AI prompts with Creem's
# Moderation API, which is required for AI image products. In production
# every AI request is refused without it.
CREEM_API_KEY=
# Server-only. The signing secret of the webhook endpoint that points at
# /api/creem/webhook (Developers → Webhooks, or: creem webhooks create).
CREEM_WEBHOOK_SECRET=
# Server-only. A long random string (e.g. openssl rand -hex 32). Supabase's
# hourly pg_cron job sends it to /api/billing/downgrades; store the same value
# in Vault as pigxel_cron_secret (see the README).
CRON_SECRET=

# Apple sign-in (optional). The Services ID also set in Supabase
# (Authentication → Sign In / Providers → Apple). Without it the Apple
# login button is disabled. The generated Apple client secret belongs in
# Supabase's Apple provider configuration, not in the browser. Server-only.
APPLE_CLIENT_ID=

# Only for local Supabase: its config.toml references this generated JWT.
# Supabase CLI needs APPLE_SECRET in its own process environment; it does not
# inherit Next.js apps/web/.env.local. Hosted Supabase stores the JWT in its
# dashboard instead. Rotate before expiry (at most six months).
# APPLE_SECRET=

# AI (server-only): Google Gemini. AI_MODEL and AI_IMAGE_MODEL pick the text
# and image models to try first (see src/lib/ai/constants.ts).
GEMINI_API_KEY=
AI_MODEL=
AI_IMAGE_MODEL=

# Dev only: the key that opens the asset review page at /internal/assets.
# Its Publish and Delete use SUPABASE_SECRET_KEY above.
ASSETS_REVIEW_KEY=
